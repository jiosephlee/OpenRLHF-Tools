    "smiles"\\n        ],\\n        "additionalProperties": false\\n      }\\n    }\\n  },\\n  {\\n    "type": "function",\\n    "function": {\\n      "name": "get_hba",\\n      "description": "Return Lipinski H-bond acceptors count.",\\n      "parameters": {\\n        "type": "object",\\n        "properties": {\\n          "smiles": {\\n            "type": "string",\\n            "description": "SMILES string of the molecule."\\n          }\\n        },\\n        "required": [\\n          "smiles"\\n        ],\\n        "additionalProperties": false\\n      }\\n    }\\n  },\\n  {\\n    "type": "function",\\n    "function": {\\n      "name": "get_num_rotatable_bonds",\\n      "description": "Return rotatable bonds count.",\\n      "parameters": {\\n        "type": "object",\\n        "properties": {\\n          "smiles": {\\n            "type": "string",\\n            "description": "SMILES string of the molecule."\\n          }\\n        },\\n        "required": [\\n          "smiles"\\n        ],\\n        "additionalProperties": false\\n      }\\n    }\\n  },\\n  {\\n    "type": "function",\\n    "function": {\\n      "name": "get_fraction_csp3",\\n      "description": "Return FractionCSP3 = (# sp3 carbon atoms)/(# total carbon atoms), Often used as a simple “3D character / saturation” proxy from 2D structure.",\\n      "parameters": {\\n        "type": "object",\\n        "properties": {\\n          "smiles": {\\n            "type": "string",\\n            "description": "SMILES string of the molecule."\\n          }\\n        },\\n        "required": [\\n          "smiles"\\n        ],\\n        "additionalProperties": false\\n      }\\n    }\\n  },\\n  {\\n    "type": "function",\\n    "function": {\\n      "name": "get_mol_mr",\\n      "description": "Return Wildman–Crippen molar refractivity (MR).",\\n      "parameters": {\\n        "type": "object",\\n        "properties": {\\n          "smiles": {\\n            "type": "string",\\n            "description"