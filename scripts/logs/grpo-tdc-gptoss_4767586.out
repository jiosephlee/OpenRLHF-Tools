an–Crippen molar refractivity (MR).\\ntype get_mol_mr = (_: {\\n// SMILES string of the molecule.\\nsmiles: string\\n}) => any;\\n\\n// Return total ring count.\\ntype get_ring_count = (_: {\\n// SMILES string of the molecule.\\nsmiles: string\\n}) => any;\\n\\n// Return aromatic ring count.\\ntype get_num_aromatic_rings = (_: {\\n// SMILES string of the molecule.\\nsmiles: string\\n}) => any;\\n\\n// Return net formal charge (sum of atom formal charges as encoded in the SMILES).\\ntype get_formal_charge = (_: {\\n// SMILES string of the molecule.\\nsmiles: string\\n}) => any;\\n\\n// Return QED (Quantitative Estimate of Drug-likeness) as implemented in RDKit.\\ntype get_qed = (_: {\\n// SMILES string of the molecule.\\nsmiles: string\\n}) => any;\\n\\n// Return heteroatom count (non C/H).\\ntype get_num_heteroatoms = (_: {\\n// SMILES string of the molecule.\\nsmiles: string\\n}) => any;\\n\\n// Accurately parse functional groups with attachment points, corresponding fragment SMILES, and atom ids in the SMILES string for better structure description.\\ntype describe_high_level_fg_fragments = (_: {\\n// The SMILES string to parse.\\nsmiles: string\\n}) => any;\\n\\n// Desalt a SMILES by removing salts/counterions and keeping ONLY the largest organic fragment. Use this tool when the SMILES contains multiple disconnected components separated by \'.\' and one or more components are likely inorganic ions/solvents (e.g., [Na+], Cl-, Br-, I-, [K+], [Li+], [Ca2+], [Mg2+], [NH4+], sulfate/phosphate, etc.), or when you want the parent (active) molecule for downstream property prediction.\\nIn aqueous/physiological conditions, salts typically dissociate; counterions are usually not part of the parent drug structure for many structure-based predictions.\\nTypical examples needing desalting: \'CC(=O)O.[Na+]\', \'[Na+].O=C(O)c1ccccc1\', \'CCO.Cl\'.\\nDo NOT use if the SMILES is already a single component (no \'.\') or if multiple organic fragments represent real mixture/co-crystal/combination therapy that should be kept. Output is the canonical SMILES of the retained parent fragment; smaller fragments are discarded.\\ntype remove_salts = (_: {\\n// SMILES string of the molecule.\\nsmiles: string\\n}) => any;\\n\\n// Predict pKa values for ionizable sites in a molecule. Returns base-site and acid-site pKa values (1-indexed atom map numbers), the most basic/acidic pKa, the number of basic/acidic sites, and the atom-mapped SMILES.\\ntype predict_pka = (_: {\\n// SMILES string of the molecule.\\nsmiles: string\\n}) => any;\\n\\n// Estimate logD at a target pH from predicted pKa values and RDKit logP. Uses a Henderson-Hasselbalch approximation: logD(pH) ≈ logP + log10(f_neutral). logP is RDKit Wildman-Crippen logP. This is a heuristic intended for helpingyour reasoning and should not be treated as experimental logD. For polyprotic molecules, uses the most basic and most acidic predicted pKa values.\\ntype estimate_logd = (_: {\\n// SMILES string of the molecule.\\nsmiles: string,\\n// Target pH (default: 7.4).\\nph?: number\\n}) => any;\\n\\n// Screen a molecule against RDKit\'s built-in structural alert catalogs (PAINS, Brenk, NIH, ZINC, ChEMBL, etc.).\\ntype score_structural_alerts = (_: {\\n// SMILES string of the molecule.\\nsmiles: string,\\n// Alert library to screen against (default: all).\\nalert_library?: "all" | "pains" | "pains_a" | "pains_b" | "pains_c" | "brenk" | "nih" | "zinc" | "chembl" | "chembl_bms" | "chembl_lint" | "chembl_mlsmr"\\n}) => any;\\n\\n// Return fraction of aromatic atoms.\\ntype get_fraction_aromatic_atoms = (_: {\\n// SMILES string of the molecule.\\nsmiles: string\\n}) => any;\\n\\n// Return aromatic atom count.\\ntype get_num_aromatic_atoms = (_: {\\n// SMILES string of the molecule.\\nsmiles: string\\n}) => any;\\n\\n// Return max absolute Gasteiger partial charge.\\ntype get_max_abs_partial_charge = (_: {\\n// SMILES string of the molecule.\\nsmiles: string\\n}) => any;\\n\\n// Return min absolute Gasteiger